"父：根の音は数えない。根は0、となりを1つ目にする。右なら\\(right)、左なら\\(left)。今回は\\(direction)。" = "Father: Do not count the root sound. The root is 0; the next key is 1. Right is \\(right), left is \\(left). This time: \\(direction).";
"父：根は0。となりを1つ目にして、\\(direction)。" = "Father: The root is 0. Count the next key as 1, then go \\(direction).";
